<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cloud.changlu.agentforge.service.modules.upload.dao.FileInfoMapper">

    <resultMap id="FileInfoResult" type="cloud.changlu.agentforge.service.modules.upload.domain.pojo.FileInfoPojo">
        <id property="id" column="id"/>
        <result property="fileName" column="file_name"/>
        <result property="originFileName" column="origin_file_name"/>
        <result property="visitUrl" column="visit_url"/>
        <result property="fileType" column="file_type"/>
        <result property="fileSize" column="file_size"/>
        <result property="storageMode" column="storage_mode"/>
        <result property="createUserId" column="create_user_id"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="createTime" column="create_time"/>
        <result property="modifyTime" column="modify_time"/>
    </resultMap>

    <sql id="columns">
        id, file_name, origin_file_name, visit_url, file_type, file_size,
        storage_mode, create_user_id, is_deleted, create_time, modify_time
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        insert into ai_file_info
            (file_name, origin_file_name, visit_url, file_type, file_size,
             storage_mode, create_user_id, is_deleted)
        values
            (#{fileName}, #{originFileName}, #{visitUrl}, #{fileType}, #{fileSize},
             #{storageMode}, #{createUserId}, 0)
    </insert>

    <select id="selectById" resultMap="FileInfoResult">
        select <include refid="columns"/> from ai_file_info
        where id = #{id} and is_deleted = 0
    </select>

    <select id="selectByIds" resultMap="FileInfoResult">
        select <include refid="columns"/> from ai_file_info
        where is_deleted = 0 and id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
