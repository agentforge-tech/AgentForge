IMAGE_REPO=codercl/agentforge-service
IMAGE_TAG=latest
WEB_PORT=18080
APP_NAME=agentforge-service
TZ=Asia/Shanghai

AGENTFORGE_DB_TYPE=sqlite
AGENTFORGE_SQLITE_PATH=/opt/agentforge/data/agentforge.db
AGENTFORGE_SQLITE_INCREMENT_DIR=/opt/agentforge/sql/sqllite

AGENTFORGE_DB_URL=
AGENTFORGE_DB_USERNAME=
AGENTFORGE_DB_PASSWORD=
AGENTFORGE_DB_POOL_SIZE=10

OPENREACH_BASE_URL=http://openreach.changlu.cloud
AGENTFORGE_FILE_VISIT_PROTOCOL=http
AGENTFORGE_FILE_VISIT_HOST=127.0.0.1
AGENTFORGE_FILE_VISIT_PORT=18080
AGENTFORGE_FILE_VISIT_PATH=/upload

JAVA_OPTS=-Xms256m -Xmx512m
